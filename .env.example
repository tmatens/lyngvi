# lyngvi — runtime SECRETS (scoped, least-privilege). Never commit a real .env.
# Produce it on the host with your secrets mechanism (SOPS, a vault agent, a
# 0600 file) and keep it out of git; compose loads it with required: false.
# Non-secret values go in site/site.conf instead.

# SSH private key for git over SSH (the forge deploy/bot key), base64-encoded so
# it fits the dotenv model:   base64 -w0 < ./that_key
# It is ALSO the commit-signing key. Register its .pub as an auth key on the bot
# account and as a SIGNING key for "Verified" commits (BOOTSTRAP.md).
GIT_SSH_KEY_B64=

# GitHub fine-grained PAT, scoped to specific repos only (Contents, Pull requests,
# Issues; never Administration or Workflows unless a documented need).
GITHUB_TOKEN=
# LYNGVI_MODE=api-key only (docs/API_KEY_MODE.md): an Anthropic API key from a Console
# workspace with its own spend limit. Only the token relay reads it; the agent never does.
#LYNGVI_ANTHROPIC_API_KEY=

# Forge REST API token (issues R/W + repository read; NO merge scope — that is one
# of the mechanical gates). Required for the forgejo MCP adapter. (The pre-split
# name FORGEJO_API_TOKEN is still honored for one release, with a warning.)
FORGE_API_TOKEN=

# Optional: notification target when it is itself a secret — a URL that embeds a
# token (Gotify, a Discord webhook) or an ntfy access token. A plain topic URL can
# live in site.conf NOTIFY_URL instead; the kind and throttle live there too.
#NOTIFY_URL=
#NOTIFY_TOKEN=

# Optional second identities (see site-example/gitconfig):
#   SSH_KEY_<NAME>_B64=            → loaded as ~/.ssh/<name>
#   GIT_HTTPS_CREDENTIAL_<NAME>=https://<user>:<token>@github.com/<owner>/<repo>
